# Copy to .env in this workspace root. Never commit or share .env.
# The local Next.js dev server loads this file server-side; production uses its secret manager.

# PostgreSQL with the pgvector extension enabled
DATABASE_URL=
DATABASE_SSL=false

# Microsoft Entra single-tenant sign-in
AUTH_SECRET=
AUTH_URL=http://localhost:3000
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ACCESS_APP_ROLE=GTM OS Access
BOOTSTRAP_ADMIN_OID=
APPROVER_ENTRA_OID=

# Inbound research and search providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LITELLM_BASE_URL=
LITELLM_API_KEY=
SERPER_API_KEY=

# Optional approved source routes
CRAWL4AI_WORKER_URL=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# Development-only read-only dashboard for register preview without Entra/PostgreSQL
LOCAL_DASHBOARD_PREVIEW=false
